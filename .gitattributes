# Image catalogs and their signatures are generated by this fork's own CI
# against its own registry, so upstream's versions are never the ones we
# want: keep ours on every merge instead of resolving the conflict by hand.
#
# Requires the driver to be defined once per clone:
#   git config merge.ours.driver true
# Without it git falls back to a normal conflict, never to a silent wrong
# resolution.
Debian/ClusterImageCatalog-*.yaml               merge=ours
Debian/ClusterImageCatalog-*.yaml.sigstore.json merge=ours
